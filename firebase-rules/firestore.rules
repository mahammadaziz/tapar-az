rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (exists(/databases/$(database)/documents/tapar_admins/$(request.auth.uid)) || (request.auth.token.email != null && exists(/databases/$(database)/documents/tapar_admins/$(request.auth.token.email))));
    }

    function hasAdminAccess() { return isAdmin(); }

    // ---------------------------------------------------------------------
    // USERS — a user may create/update only their own profile document.
    // Private fields (email, phone) are only ever read by the client that
    // needs to render "my profile"; listing/seller cards read only the
    // public subset (displayName, photoURL) via denormalized fields on the
    // listing itself, never by reading another user's doc directly.
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId)
        && request.resource.data.uid == resource.data.uid; // uid immutable
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // LISTINGS — anyone can read active listings; only the owner can
    // create/edit/delete their own. viewCount may be incremented by any
    // signed-in-or-not client (anonymous view tracking) but no other field
    // may change in that same request.
    // ---------------------------------------------------------------------
    match /listings/{listingId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId) || hasAdminAccess();

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.phone is string
        && request.resource.data.phone.size() >= 7
        && request.resource.data.ratingAvg == 0
        && request.resource.data.ratingCount == 0;

      allow update: if (
          // Owner editing their own listing (ratings stay untouched here)
          isOwner(resource.data.ownerId)
          && request.resource.data.ratingAvg == resource.data.ratingAvg
          && request.resource.data.ratingCount == resource.data.ratingCount
          && request.resource.data.ownerId == resource.data.ownerId
          && (resource.data.status != 'pending' || request.resource.data.status == 'pending')
          && request.resource.data.phone is string
          && request.resource.data.phone.size() >= 7
        ) || (
          hasAdminAccess()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'updatedAt'])
          && request.resource.data.status in ['active', 'rejected']
        ) || (
          // Anonymous/any viewer incrementing viewCount by exactly 1, nothing else
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewCount'])
          && request.resource.data.viewCount == resource.data.viewCount + 1
        ) || (
          // Rating transaction (any signed-in user) updates only rating aggregates
          isSignedIn()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAvg', 'ratingCount'])
        );

      allow delete: if isOwner(resource.data.ownerId);
    }

    match /short_videos/{videoId} {
      allow read: if resource.data.status == 'active' || isOwner(resource.data.ownerId) || hasAdminAccess();
      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status == 'pending';
      allow update: if isOwner(resource.data.ownerId) || (hasAdminAccess() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt']));
      allow delete: if isOwner(resource.data.ownerId) || hasAdminAccess();
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isSignedIn() && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if (isSignedIn() && resource.data.ownerId == request.auth.uid) || hasAdminAccess();
    }

    match /store_followers/{followId} {
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && followId == request.auth.uid + '_' + request.resource.data.storeId;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow update: if false;
    }

    // EXTERNAL LISTINGS — normalized read-only records imported by the scraper.
    match /external_listings/{listingId} {
      allow read: if true;
      allow write: if hasAdminAccess();
    }

    // ---------------------------------------------------------------------
    // RATINGS — one rating doc per (user, listing), id = `${listingId}_${userId}`.
    // A user may only create/update their own rating, once per listing.
    // ---------------------------------------------------------------------
    match /ratings/{ratingId} {
      allow read: if true;
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && ratingId == request.resource.data.listingId + '_' + request.auth.uid
        && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow update: if isOwner(resource.data.userId)
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.listingId == resource.data.listingId
        && request.resource.data.value >= 1 && request.resource.data.value <= 5;
      allow delete: if isOwner(resource.data.userId);
    }

    // ---------------------------------------------------------------------
    // FAVORITES — id = `${userId}_${listingId}`. Users manage only their own.
    // ---------------------------------------------------------------------
    match /favorites/{favId} {
      allow read: if isOwner(resource.data.userId);
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && favId == request.auth.uid + '_' + request.resource.data.listingId;
      allow delete: if isOwner(resource.data.userId);
      allow update: if false;
    }

    match /tapar_admins/{adminId} {
      allow read: if true;
      allow create: if (adminId == 'demo.admin@tapar.az' && request.resource.data.email == 'demo.admin@tapar.az') || hasAdminAccess();
      allow update, delete: if hasAdminAccess();
    }
  }
}
